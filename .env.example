# FITCORE PRO — CONFIGURAÇÕES DE AMBIENTE (.env.example)

# Aplicação
VITE_APP_NAME="FITCORE PRO"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# Supabase (Banco de Dados & Autenticação)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-publica"

# Provedor de Pagamentos (Stripe)
VITE_STRIPE_PUBLIC_KEY="pk_test_sua_chave_publica_aqui"
# STRIPE_SECRET_KEY="sk_test_sua_chave_secreta_aqui" (Usada apenas no backend/Edge Function)
# STRIPE_WEBHOOK_SECRET="whsec_seu_webhook_secret_aqui"

# Provedor de Pagamentos (Mercado Pago)
VITE_MERCADOPAGO_PUBLIC_KEY="TEST-sua-chave-publica"
# MERCADOPAGO_ACCESS_TOKEN="TEST-seu-token-de-acesso"

# Provedor de Notificações / E-mail (Ex: Resend ou SendGrid)
# RESEND_API_KEY="re_sua_chave_aqui"

# Provedor de Inteligência Artificial (Opcional - Ex: Google Gemini / OpenAI)
# GEMINI_API_KEY="sua_chave_gemini_aqui"
